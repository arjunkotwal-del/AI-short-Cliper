OPENAI_API_KEY=sk-proj-...

# Optional — uncomment to override defaults
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/   # Gemini (then OPENAI_MODEL=gemini-3.8-flash)
# LOCAL_WHISPER_MODEL=base          # tiny / base / small / medium / large / large-v3
# LOCAL_WHISPER_DEVICE=auto         # auto / cpu / cuda
# LOCAL_OUTPUT_DIR=output
# YTDLP_JS_RUNTIMES=deno,node       # JS runtimes yt-dlp may use for YouTube downloads
# MOCK_LLM=false                    # true = offline placeholder LLM answers
